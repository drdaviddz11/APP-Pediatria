# Opcional: datos del proyecto de Supabase para que la pantalla de Sincronización ya los tenga escritos.
# Copie este archivo como ".env" (ese archivo NO se sube a GitHub) y reemplace los valores.
# La clave pública (publishable) no es secreta; la seguridad la dan la contraseña y las reglas por fila.
EXPO_PUBLIC_SUPABASE_URL=https://abcd1234.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Cliente de Google para respaldar en el Google Drive de cada usuario (no es secreto; el "secreto del cliente" NUNCA va aquí).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=943608219294-60sckk05i7jpn9qvg7j2teq11arpduj5.apps.googleusercontent.com
