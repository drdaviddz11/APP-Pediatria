{
  "expo": {
    "name": "PediaControl Pro",
    "slug": "pediacontrol-pro",
    "scheme": "pediacontrol",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pediacontrol.pro"
    },
    "android": {
      "package": "com.pediacontrol.pro"
    },
    "web": {
      "output": "single"
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
