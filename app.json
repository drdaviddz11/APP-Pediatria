{
  "expo": {
    "name": "PediaControl Pro",
    "slug": "pediacontrol-pro",
    "scheme": "pediacontrol",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pediacontrol.pro"
    },
    "android": {
      "package": "com.pediacontrol.pro"
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      ["expo-local-authentication", { "faceIDPermission": "PediaControl Pro usa Face ID para abrir la app sin escribir su clave." }]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
